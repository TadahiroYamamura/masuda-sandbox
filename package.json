{
  "name": "masuda-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "masuda-sandbox": "./dist/cli.js"
  },
  "scripts": {
    "generate": "buf generate",
    "build": "node scripts/gen-version.mjs && tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs",
    "start": "node dist/cli.js",
    "test": "node scripts/gen-version.mjs && vitest run --exclude test/contract",
    "test:contract": "vitest run test/contract"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1",
    "@bufbuild/protobuf": "^2",
    "@connectrpc/connect": "^2",
    "@connectrpc/connect-node": "^2",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "README.md"
  ]
}
